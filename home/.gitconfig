[user]
	name = Richard Tynan
	email = richard@tynan.me
[credential]
  helper = cache --timeout=3600
[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  ui = auto
[merge]
  tool = vimdiff
[core]
  excludesfile = ~/.global_gitignore
  ; hooksPath = ~/.githooks/
[push]
	default = current
[pull]
	default = current
  rebase = true
[fetch]
  prune = true
	writeCommitGraph = true
[diff]
  colorMoved = zebra
[hub]
  protocol = ssh
[alias]
  s = status
  st = status
  ad = add
  d = diff
  dif = diff
  co = checkout
  amend = commit --amend
  revall = reset --hard HEAD
  prev = checkout HEAD~
  m = checkout master
  pul = pull
  p = pull
  ; Shows a graph of all branches  for the last 1 week.
  smartlog = log --graph --branches --not master~5 --boundary --since=1.week --pretty=format:'commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%C(cyan)%s%n%Creset'
  sl = !git smartlog
  ; Shows a graph of all branches that have been modified in the last n weeks, defaults to 1 week.
  ssl = "!f() { git log --graph --boundary --pretty=format:'commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%C(cyan)%s%n%Creset' $(git for-each-ref --format='%(refname:short) %(committerdate:unix)' refs/heads | awk -v c=$(($(date +%s)-${1:-1}*7*86400)) '$2>c{print $1}') --not master; }; f"
  ; Shows a graph of the last n commits (default 10) across local branches and ahead/behind vs master. Appends HEAD if it falls outside the window.
  bl = "!f() { n=${1:-10}; fmt='%C(bold red)%h%Creset%C(bold magenta)%d%Creset %C(cyan)%s%Creset %C(yellow)(%cr)%Creset %C(blue)<%an>%Creset'; git log --graph -n $n --pretty=format:\"$fmt\" --branches HEAD; echo; if ! git rev-list --topo-order -n $n --branches HEAD | grep -q $(git rev-parse HEAD); then echo '┆ … HEAD is further back:'; git log --graph -n 3 --pretty=format:\"$fmt\" HEAD; echo; fi; git rev-list --left-right --count master...HEAD | awk '{print \"vs master: \" $2 \" ahead, \" $1 \" behind\"}'; }; f"
  clearmerged = "!git co dev; git branch --merged | grep -v '* dev' | awk '{print $1}' | xargs -p git branch -D"
  f = "!gitf() { git switch -c \"rptynan/$1\"; }; gitf"
[init]
  defaultBranch = master
[difftool "nvim_difftool"]
	cmd = nvim -c \"packadd nvim.difftool\" -d \"$LOCAL\" \"$REMOTE\"
[diff]
  tool = nvim_difftool
[include]
  path = ~/.gitconfig.local
